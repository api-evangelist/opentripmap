        {
          "id": "a4382f9e-d692-409f-9c1f-7a6d006c88b6",
          "name": "get List Of Places By Location",
          "request": {
            "name": "get List Of Places By Location",
            "description": {
              "content": "Method returns all objects (or number of objects) in the given bounding box optionally filtered by parameters. Only basic information is include in response: xid, name, kinds, osm, wikidata and geometry of each object.\nDepending on the chosen format, the response is either a simple array of objects (with a smaller volume) or an object in GeoJSON format.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":lang",
                "places",
                "bbox"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lon_min",
                  "value": "<double>",
                  "description": "(Required) Minimum longitude"
                },
                {
                  "disabled": false,
                  "key": "lon_max",
                  "value": "<double>",
                  "description": "(Required) Maximum longitude"
                },
                {
                  "disabled": false,
                  "key": "lat_min",
                  "value": "<double>",
                  "description": "(Required) Minimum latitude"
                },
                {
                  "disabled": false,
                  "key": "lat_max",
                  "value": "<double>",
                  "description": "(Required) Maximum latitude"
                },
                {
                  "disabled": false,
                  "key": "src_geom",
                  "value": "<string>",
                  "description": "The source of the object geometry.\nObjects from all sources are returned by default."
                },
                {
                  "disabled": false,
                  "key": "src_attr",
                  "value": "<string>",
                  "description": "The source of the object attributes.\nIt is allowed to point multiple sources separated by commas.\nObjects from all sources are returned by default."
                },
                {
                  "disabled": false,
                  "key": "kinds",
                  "value": "<string>",
                  "description": "Object category. Several comma-separated categories may be stated with OR logic. [see List of categories](https://dev.opentripmap.org/catalog). \nObjects from interesting_places category are returned by default"
                },
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "The text string on which to search at the begining of the object name (mimimum 3 characters). All objects are returned by default."
                },
                {
                  "disabled": false,
                  "key": "rate",
                  "value": "<string>",
                  "description": "Minimum rating of the object popularity, 1 - minimum, 3- maximum, h - object is referred to the cultural heritage.\nObjects from all ratings are returned by default."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "The output format (GeoJSON  is set by default). Specify “count” to get the number of obtained objects"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "MMaximum number of returned objects. 500 is set by default.\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "lang",
                  "description": "(Required) Language code (2 characters, ISO639-1). The following values are available: en (english), ru (russian)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
