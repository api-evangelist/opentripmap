          "name": "get Geoname",
          "request": {
            "name": "get Geoname",
            "description": {
              "content": "Returns geographic coordinates for the given placename (region, city, village, etc.). The method returns the place whose name is most similar to the search string. Service based on GeoNames database.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":lang",
                "places",
                "geoname"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "(Required) Placename"
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "Two-letter country code, ISO-3166 (optional). Default is all countries."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "lang",
                  "description": "(Required) Two-letter language code (ISO639-1). The following values are available: en (english), ru (russian)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "apikey"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
